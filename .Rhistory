# RNA-seq Analysis in R (Part 1): tximport -> Gene-level Count Table
# 1. Install and load packages
# Run the install line ONCE, then comment it out.
pak::pkg_install(c("tidyverse", "tximport", "EnsDb.Hsapiens.v86", "AnnotationDbi"))
# Load packages
library(tidyverse)
library(tximport)
library(EnsDb.Hsapiens.v86)
# 2. Locate the Salmon quant files
# Each sample has its own folder under outputs/salmon_out/, containing quant.sf
samples <- list.dirs("outputs/salmon_out", recursive = FALSE, full.names = FALSE)
samples
# Build the full path to each sample's quant.sf and name it by sample
quant_files <- file.path("outputs/salmon_out", samples, "quant.sf")
names(quant_files) <- samples
print(quant_files)
quant_files
print(quant_files)
# Safety check: every file must exist (all should print TRUE)
file.exists(quant_files)
EnsDb.Hsapiens.v86
columns(EnsDb.Hsapiens.v86)
keys(EnsDb.Hsapiens.v86)
tx2gene <- AnnotationDbi::select(
EnsDb.Hsapiens.v86,
keys    = keys(EnsDb.Hsapiens.v86),
columns = c("TXID", "SYMBOL")
)
View(tx2gene)
columns(EnsDb.Hsapiens.v86)
# Keep only transcript ID + symbol (drop the gene ID column)
tx2gene <- dplyr::select(tx2gene, TXID, SYMBOL)
head(tx2gene)
View(tx2gene)
# 4. Import and summarize to gene level
txi <- tximport(
files               = quant_files,
type                = "salmon",
tx2gene             = tx2gene,
ignoreTxVersion     = TRUE,
countsFromAbundance = "lengthScaledTPM"
)
class(txi)          # "list"
head(txi$counts)    # raw gene-level counts
head(txi$abundance) # gene-level TPM
class(txi)          # "list"
head(txi$counts)    # raw gene-level counts
head(txi$abundance) # gene-level TPM
raw_counts <- txi$counts
write.csv(raw_counts, "outputs/tables/raw_counts.csv", row.names = TRUE)
# 5. Save the count table (the reusable product of this step)
# Raw counts (row.names = gene symbols) -> keep the gene column when writing CSV
raw_counts <- txi$counts
write.csv(raw_counts, "outputs/tables/raw_counts.csv", row.names = TRUE)
raw_counts <- txi$counts
write.csv(raw_counts, "outputs/tables/raw_counts.csv", row.names = TRUE)
write_rds(raw_counts, "outputs/tables/raw_counts.rds")
raw_counts <- txi$counts
write.csv(raw_counts, "outputs/tables/raw_counts.csv", row.names = TRUE)
write_rds(raw_counts, "outputs/tables/raw_counts.rds")
# TPM (normalized abundance)
tpm_counts <- txi$abundance
write.csv(tpm_counts, "outputs/tables/tpm_counts.csv", row.names = TRUE)
write_rds(tpm_counts, "outputs/tables/tpm_counts.rds")
# Save the whole tximport object. The DESeq2 step needs it (not just the CSV),
# because DESeqDataSetFromTximport() uses the transcript-length information.
write_rds(txi, "outputs/tables/txi.rds")
View(tpm_counts)
library(tidyverse)
# Gene-level counts produced by 02a_tximport_counts.R
raw_counts <- readRDS("outputs/tables/raw_counts.rds")
# Round to whole numbers just for viewing / plotting
data <- as.data.frame(round(raw_counts))
View(data)
p_hist <- ggplot(data) +
geom_histogram(aes(x = SRR1039508), bins = 200) +
xlab("Raw expression counts") +
ylab("Number of genes")
p_hist
ggsave("outputs/figures/count_distribution_SRR1039508.png",
p_hist, width = 7, height = 5, dpi = 300)
# 3. Mean vs variance across the Untreated replicates
# The four Untreated replicates in our design
untreated <- c("SRR1039508", "SRR1039512", "SRR1039516", "SRR1039520")
# 3. Mean vs variance across the Untreated replicates
# The four Untreated replicates in our design
untreated <- c("SRR1039508", "SRR1039512", "SRR1039516", "SRR1039520")
# For each gene, mean and variance across those four samples
mean_counts     <- apply(data[, untreated], 1, mean)
variance_counts <- apply(data[, untreated], 1, var)
df <- data.frame(mean_counts, variance_counts)
mean_counts
variance_counts
# Red line = where mean would equal variance (the Poisson assumption).
# Points sitting ABOVE the line show variance > mean (overdispersion),
# which is why we use the Negative Binomial (DESeq2), not Poisson.
p_mv <- ggplot(df) +
geom_point(aes(x = mean_counts, y = variance_counts), alpha = 0.3) +
scale_x_log10() +
scale_y_log10() +
geom_abline(intercept = 0, slope = 1, color = "red") +
xlab("Mean count (Untreated replicates)") +
ylab("Variance (Untreated replicates)")
p_mv <- ggplot(df) +
geom_point(aes(x = mean_counts, y = variance_counts), alpha = 0.3) +
scale_x_log10() +
scale_y_log10() +
geom_abline(intercept = 0, slope = 1, color = "red") +
xlab("Mean count (Untreated replicates)") +
ylab("Variance (Untreated replicates)")
ggsave("outputs/figures/mean_vs_variance_untreated.png",
p_mv, width = 7, height = 5, dpi = 300)
library(DESeq2)
